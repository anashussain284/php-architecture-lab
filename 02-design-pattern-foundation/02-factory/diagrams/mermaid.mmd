    class PaymentProcessorFactory {
        +create(string type): PaymentProcessor
        +createStripe(): PaymentProcessor
        +createPayPal(): PaymentProcessor
    }
    
    class PaymentController {
        -PaymentProcessorFactory $factory
        +__construct(PaymentProcessorFactory $factory)
        +process(Request, Order)
